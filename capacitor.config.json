{
  "appId": "com.blanks247.puzzlepattern",
  "appName": "Puzzle Pattern",
  "webDir": "dist",
  "backgroundColor": "#0f172a",
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchShowDuration": 0,
